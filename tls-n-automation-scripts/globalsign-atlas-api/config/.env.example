# ==============================================================================
# GlobalSign Atlas Environment Template
# ==============================================================================
# 
# Copie este arquivo para .env na raiz do projeto e preencha os valores.
# ATENÇÃO: NUNCA commite o .env real no repositório.
# ==============================================================================

# Diretório onde os segredos estão armazenados (fora do repositório)
# Exemplo: ~/.secrets/globalsign-atlas-api
# Exemplo: /home/usuario/0_bressix/bressix-labs-workspace-appendix/atlas_secrets
ATLAS_SECRETS_DIR=~/.secrets/globalsign-atlas-api

# URL base da API GlobalSign Atlas
# Consulte a documentação para a região correta
ATLAS_BASE_URL=https://emea.api.hvca.globalsign.com:8443/v2

# User Agent personalizado (opcional)
ATLAS_USER_AGENT="Atlas-Automation-Client/1.0"

# Modo verboso - exibe logs detalhados das requisições (opcional)
# VERBOSE=1
